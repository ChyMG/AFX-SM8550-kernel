BRANCH=android13-5.15
CLANG_VERSION=r450784e
LLVM=1
LLVM_IAS=1
DEPMOD=depmod
CLANG_PREBUILT_BIN=prebuilts/clang/host/linux-x86/clang-${CLANG_VERSION}/bin
ARCH=arm64
DEFCONFIG=gki_defconfig
MAKE_GOALS="Image"
FILES="arch/arm64/boot/Image vmlinux System.map"
NDK_TRIPLE=
HERMETIC_TOOLCHAIN=0
SKIP_CP_KERNEL_HDR=1
LTO=none
KLEAF_SUPPRESS_BUILD_SH_DEPRECATION_WARNING=1

function afx_merge_config() {
  local K="${ROOT_DIR}/${KERNEL_DIR}"
  set -x
  "${K}/scripts/kconfig/merge_config.sh" -m -O "${OUT_DIR}" "${OUT_DIR}/.config" \
    "${K}/arch/arm64/configs/vendor/vermeer_GKI.config" \
    "${ROOT_DIR}/newbuild/configs/need.config" "${ROOT_DIR}/newbuild/configs/extra.config"
  ( cd "${OUT_DIR}" && make ${TOOL_ARGS} O="${OUT_DIR}" olddefconfig )
}
POST_DEFCONFIG_CMDS="afx_merge_config"
